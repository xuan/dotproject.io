source "https://rubygems.org"

# GitHub Pages (classic "Deploy from a branch") builds this site with the
# github-pages gem set. Pinning it keeps local builds in sync with production.
# Requires a modern Ruby (>= 3.0); the macOS system Ruby 2.6 is too old.
gem "github-pages", group: :jekyll_plugins

# `jekyll serve` on Ruby 3.0+ needs webrick (no longer in the stdlib).
gem "webrick", "~> 1.9"
