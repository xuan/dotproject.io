!images/canvas1/canvas1-720.jpg
!images/canvas1/canvas1-960.jpg
!images/canvas1/canvas1-1440.jpg
!images/canvas1/canvas1.dzi
!images/canvas1/canvas1_files/
!images/canvas1/dots.json
!images/canvas1/texts.json
